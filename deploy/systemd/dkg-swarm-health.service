[Unit]
# Example only. Adapt paths and service account, then test before enabling.
Description=DKG Swarm daily health check
After=network-online.target dkg.service
Wants=network-online.target

[Service]
Type=oneshot
User=dkg
Group=dkg
WorkingDirectory=/srv/dkg/webhooks
EnvironmentFile=/etc/dkg/webhooks.env
ExecStart=/usr/bin/node /srv/dkg/webhooks/health-check.mjs
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dkg
