# Copy into a private deployment configuration; never commit real credentials.
DKG_MCP_PUBLIC_URL=https://www.dkgswarm.com
DKG_PUBLIC_GRAPH_ID=trac-marketing
DKG_MCP_HOST=127.0.0.1
DKG_MCP_PORT=27131
DKG_API_URL=http://127.0.0.1:9200
DKG_API_TOKEN=replace-with-private-node-token
DKG_MCP_OAUTH_STORE=/path/to/private/oauth.json
DKG_MCP_WRITER_CODES=/path/to/private/writer-codes.json
DKG_MCP_OAUTH_REDIRECT_HOSTS=grok.com,x.ai,claude.ai,claude.com,chatgpt.com,chat.openai.com,cursor.com
DKG_MCP_CORS_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com,https://chat.openai.com,https://grok.com,https://x.ai,https://cursor.com,https://www.cursor.com
DKG_MCP_POLICY_CURRENT=/path/to/private/policy-current.json
